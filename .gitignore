# Generated by setup.sh — contains your personal vault path
build/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Agent scratch state
.claude-flow/

# Obsidian workspace state, if anyone vaults inside the repo
.obsidian/workspace*
.obsidian/cache

# Never commit a real vault
/Brain/
/vault/

# Python
__pycache__/
*.pyc
